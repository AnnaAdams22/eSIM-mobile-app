# ESIM Global mobile — public configuration
# Only EXPO_PUBLIC_* vars are embedded in the app bundle. They are PUBLIC: anyone
# can read them from a shipped build. NEVER put secret keys here (no sb_secret_,
# no sk_ Stripe keys, no webhook secrets). Only publishable/anon keys belong here.

# Backend API base URL (Railway)
EXPO_PUBLIC_API_URL=https://refreshing-stillness-staging.up.railway.app

# Supabase (identity provider only)
EXPO_PUBLIC_SUPABASE_URL=https://rfmmpbjohoiqkxanyszk.supabase.co
# Supabase publishable key (sb_publishable_... or legacy anon JWT). PUBLIC key only.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe publishable key (pk_test_... / pk_live_...). PUBLIC key only.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Legal document URLs (optional). Shown on the Create-account screen and opened
# in an in-app browser. If unset, sensible production placeholders are used.
# EXPO_PUBLIC_TERMS_URL=https://esim-global.net/terms-and-conditions
# EXPO_PUBLIC_PRIVACY_URL=https://esim-global.net/privacy-policy

# ── Social sign-in (all optional; only PUBLIC OAuth client ids go here) ──────
# Google OAuth *Web* client id — REQUIRED for Google sign-in (it's the audience
# of the id token Supabase verifies). If blank, the Google button is hidden.
# Create it in Google Cloud → APIs & Services → Credentials (type "Web
# application") for project esim-global-41bbf.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Google OAuth *iOS* client id — REQUIRED for the native iOS Google sign-in flow.
# From Google Cloud → Credentials (type "iOS") for the app's bundle id. Public.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=53531612788-apqeg7vmudiganha106k8ts907jdacds.apps.googleusercontent.com
# Sign in with Apple — "true" shows the Apple button (iOS only) and, per App Store
# rules, then also allows Google to show on iOS. The Apple Developer account is
# now active, so iOS builds set this to "true" (see eas.json).
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=true

# ── Apple Pay (optional; default OFF) ────────────────────────────────────────
# Offer Apple Pay in the Stripe PaymentSheet (iOS). Leave unset/"false" until
# Stripe holds an Apple Pay certificate for merchant.net.esimglobal.app, so the
# sheet never shows a broken Apple Pay button. Set "true" once Apple Pay is fully
# configured in the Stripe dashboard. Google Pay (Android) is unaffected.
EXPO_PUBLIC_APPLE_PAY_ENABLED=false

# ── Launch intro style (optional; default "ivory") ───────────────────────────
# The animated opening sequence: "ivory" = black logo on warm ivory (default),
# "navy" = white logo on deep navy. This only drives the JS overlay — to fully
# switch you must ALSO update the native splash backgroundColor + image in
# app.json and rebuild. See CLAUDE.md § "Launch intro (animated opening)".
# EXPO_PUBLIC_LAUNCH_STYLE=ivory

# ── Launch intro on/off (optional; default "true") ───────────────────────────
# Master switch for the animated opening overlay. Set to "false" to skip the JS
# intro entirely (the native splash still shows). A safety valve to disable the
# intro in one line without a code change if it ever misbehaves on a device.
# EXPO_PUBLIC_LAUNCH_INTRO_ENABLED=true
