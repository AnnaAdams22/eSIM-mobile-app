# ESIM Global mobile — public configuration
# Only EXPO_PUBLIC_* vars are embedded in the app bundle. They are PUBLIC: anyone
# can read them from a shipped build. NEVER put secret keys here (no sb_secret_,
# no sk_ Stripe keys, no webhook secrets). Only publishable/anon keys belong here.

# Backend API base URL (Railway)
EXPO_PUBLIC_API_URL=https://refreshing-stillness-staging.up.railway.app

# Supabase (identity provider only)
EXPO_PUBLIC_SUPABASE_URL=https://rfmmpbjohoiqkxanyszk.supabase.co
# Supabase publishable key (sb_publishable_... or legacy anon JWT). PUBLIC key only.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe publishable key (pk_test_... / pk_live_...). PUBLIC key only.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Legal document URLs (optional). Shown on the Create-account screen and opened
# in an in-app browser. If unset, sensible production placeholders are used.
# EXPO_PUBLIC_TERMS_URL=https://esim-global.net/terms-and-conditions
# EXPO_PUBLIC_PRIVACY_URL=https://esim-global.net/privacy-policy
